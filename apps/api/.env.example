# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://edgevitals:edgevitals@localhost:5432/edgevitals_dev
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed by CORS (web build)
CORS_ORIGINS=http://localhost:8081
# Allows demo assessments with simulated fixtures. Must be false in production.
DEMO_MODE_ENABLED=false
# Shown in the consent screen. Must be set to the verified hosting region before launch.
HOSTING_REGION=
NODE_ENV=development
# Per-IP requests/minute on auth endpoints
AUTH_RATE_LIMIT_PER_MIN=10
