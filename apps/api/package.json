{
  "name": "@edgevitals/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "start:dev": "tsx src/server.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "migrate:prod": "node --enable-source-maps dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@edgevitals/domain": "0.1.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
