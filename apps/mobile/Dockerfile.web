# syntax=docker/dockerfile:1
# EdgeVitals web app image (static export served by unprivileged nginx).
# Build from the repository root:
#   docker build -f apps/mobile/Dockerfile.web \
#     --build-arg EXPO_PUBLIC_API_URL=https://api.example.com -t edgevitals-web .
# Run with API_ORIGIN set to the same API origin (used in the CSP connect-src).
ARG NODE_IMAGE=node:22-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/mobile/package.json apps/mobile/
COPY packages/domain/package.json packages/domain/
COPY packages/measurement/package.json packages/measurement/
# Behind a TLS-intercepting proxy: --secret id=npm_ca,src=/path/to/ca.pem
RUN --mount=type=secret,id=npm_ca,required=false \
    if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; \
    npm ci --workspace @edgevitals/mobile --include-workspace-root --no-audit --no-fund
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/mobile apps/mobile
# Public, non-secret build-time value: the API base URL compiled into the bundle.
ARG EXPO_PUBLIC_API_URL
RUN test -n "$EXPO_PUBLIC_API_URL" || (echo "EXPO_PUBLIC_API_URL build arg is required" >&2; exit 1)
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} \
    EXPO_NO_TELEMETRY=1 \
    EXPO_OFFLINE=1
RUN npm run build:web --workspace @edgevitals/mobile

FROM ${NGINX_IMAGE} AS runtime
COPY apps/mobile/deploy/default.conf.template apps/mobile/deploy/security-headers.inc.template /etc/nginx/templates/
COPY --from=build /src/apps/mobile/dist /usr/share/nginx/html
ENV API_ORIGIN=""
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
