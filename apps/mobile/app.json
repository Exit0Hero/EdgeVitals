{
  "expo": {
    "name": "EdgeVitals",
    "slug": "edgevitals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edgevitals.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EdgeVitals uses the front camera during a scan to estimate heart rate, HRV and breathing from subtle colour changes in your face. Video is processed on your device and never stored or uploaded.",
        "NSHealthShareUsageDescription": "If you turn on health app sync, EdgeVitals reads oxygen saturation and blood pressure that your own devices saved to Apple Health, and shows them labelled with their source. It never writes to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edgevitals.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BLOOD_PRESSURE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E5EDA"
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "If you turn on health app sync, EdgeVitals reads oxygen saturation and blood pressure that your own devices saved to Apple Health, and shows them labelled with their source. It never writes to Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withJavaCrashRecorder"
    ],
    "scheme": "edgevitals",
    "experiments": {
      "typedRoutes": false
    }
  }
}
