# nginx site for the exported EdgeVitals web build (expo export --platform web).
# Rendered by the nginx image's envsubst step; only variables defined in the
# environment (API_ORIGIN) are substituted, nginx's own $uri etc. are kept.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  gzip on;
  gzip_types text/css application/javascript text/javascript application/json application/wasm image/svg+xml;

  # Content-hashed bundles never change: cache for a year.
  location /_expo/static/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # MediaPipe runtime and face model: not content-hashed, revalidate daily.
  location /mediapipe/ {
    # Explicit types: module scripts must be served as JavaScript (with
    # nosniff, octet-stream would be refused) and older mime.types lack .mjs.
    types {
      text/javascript js mjs;
      application/wasm wasm;
      application/octet-stream tflite;
    }
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  # Everything else is the single-page app: always revalidate index.html.
  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri.html /index.html;
  }
}
