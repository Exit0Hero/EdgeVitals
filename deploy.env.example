# Copy to deploy.env for docker compose (`docker compose --env-file deploy.env up`).
# deploy.env is gitignored. Use your platform's secret manager in production.

# Postgres password for the compose `db` service.
POSTGRES_PASSWORD=
# Public URL of the API as the browser/app reaches it (no trailing slash).
PUBLIC_API_URL=https://api.example.com

# API runtime (see apps/api/.env.example for every variable)
# production enforces https CORS origins, a hosting region and no demo mode.
# For a plain-HTTP local smoke test use NODE_ENV=staging with http://localhost
# URLs instead.
NODE_ENV=production
# At least 32 random characters: `openssl rand -base64 48`
JWT_SECRET=
# Web app origin(s); production requires https and no wildcard.
CORS_ORIGINS=https://app.example.com
# Verified hosting region shown on the consent screen, e.g. "EU (Frankfurt)".
HOSTING_REGION=
DEMO_MODE_ENABLED=false
AUTH_RATE_LIMIT_PER_MIN=10
